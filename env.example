# RoyalBot 统一后端（含自建 Emby 服务器）环境配置示例
# 复制为 .env 并按需修改

# ==================== 服务 ====================
PORT=8000
HOST=0.0.0.0

# JWT 签名密钥（必填于生产环境；未设置时使用临时随机密钥，重启后登录态失效）
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# 对外访问地址（用户端账号卡 / 播放器一键导入使用）
EMBY_PUBLIC_URL=https://media.example.com
EMBY_SERVER_NAME=RoyalBot Media Server
EMBY_SERVER_ID=royalbot-emby-server

# ==================== EM / EA 分离部署（可选，推荐生产使用）====================
# 默认单进程模式：EM（面板）自己一并提供 Emby 协议面，无需配置本节。
# 分离模式：EA（Emby API 网关）独立部署，客户端直连 EA；EM 只跑面板。详见 docs/deploy-ea.md
#
# EM 是否内置 Emby 协议面（false = 交给独立的 EA 服务）
ENABLE_EMBY_GATEWAY=true
# EA 监听端口（仅分离模式使用；EA 必须与 EM 共用 SECRET_KEY 与 DATABASE_URL）
# EMBY_API_PORT=8001
# 客户端应该连接的地址（EA 的对外地址），分离模式下 EM 用它给客户端指引
# EMBY_API_PUBLIC_URL=https://emby.example.com
# EM 面板地址（可选）：EA 启动后探测它是否可达，仅告警不阻断
# EM_PANEL_URL=https://panel.example.com

# ==================== 安全 ====================
# CORS 允许来源（逗号分隔；生产环境务必设置具体域名，留空则允许所有源）
# CORS_ORIGINS=https://panel.example.com,https://www.example.com
# 注：旧版「纯数字即 user_id」的 token 兼容开关（EMBY_ALLOW_LEGACY_TOKENS）已随代码移除，
# 设置它不再有任何效果。

# ==================== 数据库 ====================
# SQLite（默认，开箱即用）
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./royalbot_unified.db
# PostgreSQL（生产推荐）
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://royalbot:password@localhost:5432/royalbot

# Redis（可选，未启用时使用内存缓存）
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# ==================== Emby 媒体库 ====================
# 转码工作目录（HLS 切片临时文件）
EMBY_TRANSCODE_DIR=/tmp/emby_transcode
# ffmpeg 路径（转码依赖，直连播放不需要）
EMBY_FFMPEG_PATH=ffmpeg

# ==================== 元数据刮削 ====================
# TMDB API Key（申请: https://www.themoviedb.org/settings/api）
# 支持多密钥轮询：逗号分隔，某个密钥超配额（429）时自动轮到下一个
TMDB_API_KEY=
# TMDB_API_KEYS=key1,key2,key3
TMDB_LANGUAGE=zh-CN

# ==================== 媒体库 / 搜索 / 刮削 ====================
# 按发行平台（Netflix / Disney+ / Apple TV+ / Prime Video / Max / Hulu /
# Paramount+ / Peacock / Crunchyroll）自动生成的虚拟媒体库总开关。
# 关闭时虚拟库既不出现在客户端媒体库列表里，用 guid 直达也返回 404。
# 每台 EA 可独立配置（分离部署时在 EA 侧设），默认开启。
ENABLE_VIRTUAL_LIBRARIES=true

# 前端构建产物目录（一般不用改）
# 用户门户与后台的构建产物路径是固定约定：user_frontend/dist 与 admin_frontend/dist。
# 只有把产物构建到别处（如镜像里另存一份）时才需要覆盖；部署自检也按这两个变量判定。
# FRONTEND_DIST=/opt/aetrix/user_frontend/dist
# ADMIN_DIST=/opt/aetrix/admin_frontend/dist

# ==================== 115 下载与转存（v2.6.5） ====================
# 115 任务的调度与执行在 EM（面板）侧；任务状态同时写入共享数据库与
# PAN115_STATE_DIR 下的 JSON 文件（临时文件 + os.replace 原子替换），
# 因此 EM / EA 重启、自更新或优雅关停后，任务会在 EM 启动时自动续跑，
# 已完成文件靠 done_keys 跳过，不会重复转存。
#
# 推荐在后台「转存 115 → 账号配置」里保存 Cookie 配置档（支持多账号与默认账号，
# 媒体库可单独绑定账号）；下面的服务器级 Cookie 只是兼容旧部署的兜底。
# PAN115_COOKIE=UID=xxx; CID=xxx; SEID=xxx; KID=xxx
# 任务状态文件目录（默认在 EMBY_TRANSCODE_DIR/pan115 下）
# PAN115_STATE_DIR=/var/lib/royalbot/pan115
# 115 Web API 地址（域名调整或被网络策略改写时可覆盖）
# PAN115_WEBAPI_BASE=https://webapi.115.com
# PAN115_SHARE_BASE=https://webapi.115.com
# PAN115_TIMEOUT=20
# 原子落盘时被强杀会留下 .tmp；超过这个秒数的残留会被自动清理（默认 900）
# PAN115_STALE_TMP_SECONDS=900

# ==================== 存储挂载（v2.6.6） ====================
# 挂载 = 把内容接进媒体库的方式，在后台「存储挂载」里建，再到「媒体库管理」绑定。
# 类型：local / strm / 115 / webdav / alist / s3 / aliyun / quark / onedrive。
# 各类型的地址、Cookie、密钥都在后台逐个填写（不回传明文），下面只是入口与超时覆盖。
#
# 远程请求超时（秒）：列目录 / 取直链 / 读 .strm 与字幕都用它
# MOUNT_TIMEOUT=20
# 远程源请求使用的 UA（部分网盘直链对 UA 有要求）
# MOUNT_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/122.0.0.0 Safari/537.36
# S3 兼容对象存储默认区域（自建 MinIO 填 us-east-1 即可）
# MOUNT_S3_REGION=us-east-1
# 阿里云盘（默认走网页版换票；填了 client_id/secret 则走开放平台）
# MOUNT_ALIYUN_ENDPOINT=https://openapi.alipan.com
# MOUNT_ALIYUN_AUTH_URL=https://auth.aliyundrive.com/v2/account/token
# 夸克网盘
# MOUNT_QUARK_BASE=https://drive-pc.quark.cn/1/clouddrive
# OneDrive / SharePoint（Microsoft Graph）
# MOUNT_GRAPH_BASE=https://graph.microsoft.com/v1.0
# MOUNT_GRAPH_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
# rclone（v2.6.7）：remote / RC 地址 / 密码都在后台逐个填写，下面只是默认值
# 推荐先起一个 rc 服务，然后挂载类型选 rclone 的 rc 模式：
#   rclone rcd --rc-serve --rc-addr 127.0.0.1:5572 --rc-user=user --rc-pass=pass
# rclone 可执行文件（不在 PATH 里时填绝对路径，如 /opt/rclone/rclone）
# MOUNT_RCLONE_BIN=rclone
# rclone 配置档（留空用默认的 ~/.config/rclone/rclone.conf）
# MOUNT_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# rc 服务默认地址
# MOUNT_RCLONE_RC_URL=http://127.0.0.1:5572

# ==================== 经济系统（v2.3.0，均可通过管理后台「经济设置」在线调整） ====================
# 支付网关（易支付兼容；以下三项也可在管理后台在线配置，优先读数据库）
# PAYMENT_GATEWAY_URL=https://pay.example.com
# PAYMENT_PARTNER_ID=your_pid
# PAYMENT_PARTNER_KEY=your_key
# 支付回调/跳转使用的站点地址
# SITE_URL=https://panel.example.com
# 签到奖励
# CHECKIN_BASE_POINTS=5
# CHECKIN_STREAK_BONUS=2
# CHECKIN_STREAK_MAX_BONUS=10
# 邀请返利
# INVITATION_REWARD_POINTS=100
# INVITATION_INVITEE_REWARD_POINTS=50
# INVITATION_REBATE_PERCENT=10
